import { Theme } from "../theme.slint";
import { Backend } from "../common.slint";
import { Icons } from "../icons.slint";

export component StatusBar inherits Rectangle {
    in property <string> title;

    x: 0;
    y: 0;
    width: 100%;
    height: 16px;
    background: Theme.status-bar;

    HorizontalLayout {
        spacing: 4px;
        padding-left: 4px;
        padding-right: 4px;
        height: 100%;

        // Clock (Settings > General > Show Clock)
        if Backend.clock-text != "": Text {
            color: Theme.text;
            text: Backend.clock-text;
            font-weight: 800;
            horizontal-stretch: 0;
            vertical-alignment: center;
        }

        // Title text
        Text {
            color: Theme.text;
            text: root.title;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        // Battery text
        Text {
            color: Theme.text;
            text: "\{Backend.battery-level}%";
            font-weight: 800;
            horizontal-stretch: 0;
            vertical-alignment: center;
        }
    }
}
