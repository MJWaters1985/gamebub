import { TextUtil } from "../text_util.slint";
import { ListView } from "std-widgets.slint";

export component ListViewBase inherits Rectangle {
    in property <int> num-items;
    in property <bool> wrap: false;
    in-out property <int> focus-item: 0;
    in-out property <bool> item-selected: false;
    in property <bool> disabled: false;
    // L / R move the highlight up / down one screenful
    in property <bool> page-keys: false;

    private property <bool> has-scrollbar: area.viewport-height > area.height;
    private property <length> scrollbar-width: 2px;
    private property <length> item-height: area.viewport-height / self.num-items;
    private property <int> into-view-item: 0;
    private property <length> into-view-item-y: root.item-y(root.into-view-item);
    callback on-item-selected(/* selected-item */ int);
    callback on-item-focused(/* focused-item*/ int);

    changed focus-item => {
        fix-focus-item();
    }

    public function fix-focus-item() {
        if (!wrap) {
            if (focus-item < 0) {
                focus-item = 0;
            } else if (focus-item >= num-items) {
                focus-item = num-items - 1;
            }
            bring-into-view(focus-item);
            return;
        }
        root.unselect();
        focus-item = mod(focus-item, num-items);
        bring-into-view(focus-item);
    }

    public function ensure-focus-visible() {
        bring-into-view(focus-item);
    }

    pure function first-visible-item() -> int {
        return min(root.num-items - 1, max(0, round(-area.viewport-y / root.item-height)));
    }

    pure function item-y(index: int) -> length {
        return area.viewport-y + index * root.item-height;
    }

    function bring-into-view(index: int) {
        if (index < 0 || index >= num-items) {
            return;
        }
        into-view-item = index;

        if (area.viewport-height <= area.height) {
            area.viewport-y = 0;
        }
        if (into-view-item-y < 0) {
            area.viewport-y += 0 - into-view-item-y;
        }
        if (into-view-item-y + item-height > area.height) {
            area.viewport-y -= into-view-item-y + item-height - area.height;
        }
    }

    protected function focus-up() {
        if (!root.item-selected) {
            root.focus-item = root.focus-item - 1;
            fix-focus-item();
            on-item-focused(root.focus-item);
        }
    }

    protected function focus-down() {
        if (!root.item-selected) {
            root.focus-item = root.focus-item + 1;
            fix-focus-item();
            on-item-focused(root.focus-item);
        }
    }

    protected function focus-page(direction: int) {
        if (!root.item-selected && root.num-items > 0) {
            // One screenful of items
            root.focus-item = clamp(
                root.focus-item + direction * max(1, floor(area.height / root.item-height)),
                0, root.num-items - 1);
            fix-focus-item();
            on-item-focused(root.focus-item);
        }
    }

    protected function select-focus-item() {
        root.item-selected = true;
        root.on-item-selected(root.focus-item);
    }

    protected function unselect() {
        root.item-selected = false;
        root.focus();
    }

    forward-focus: i-focus-scope;
    border-width: 1px;
    border-color: black;

    i-focus-scope := FocusScope {
        area := Flickable {
            x: 2px;
            y: 2px;
            width: root.has-scrollbar ? scroll-bar.x - scrollbar-width - 1px : parent.width - 4px;
            height: parent.height - 4px;
            viewport-height: contents.min-height;

            highlight := Rectangle {
                x: 0px;
                y: root.focus-item * root.item-height;
                width: parent.width;
                height: root.item-height;
                background: #bbb;

                border-color: black;
                border-width: root.item-selected ? 1px : 0px;
            }

            contents := VerticalLayout {
                alignment: start;
                @children
            }
        }

        key-pressed(event) => {
            if (disabled) {
                return reject;
            } else if (event.text == Key.UpArrow) {
                root.focus-up();
                return accept;
            } else if (event.text == Key.DownArrow) {
                root.focus-down();
                return accept;
            } else if (page-keys && event.text == "l") {
                root.focus-page(-1);
                return accept;
            } else if (page-keys && event.text == "r") {
                root.focus-page(1);
                return accept;
            } else if (event.text == "a" && !event.repeat) {
                if root.item-selected {
                    root.unselect();
                } else {
                    root.select-focus-item();
                }
                return accept;
            } else if (event.text == "b" && root.item-selected && !event.repeat) {
                root.unselect();
                return accept;
            }
            reject
        }
    }

    scroll-bar := Rectangle {
        visible: has-scrollbar;
        x: parent.width - self.width - 2px;
        y: 2px;
        width: scrollbar-width;
        height: parent.height - 4px;
        inner := Rectangle {
            y: (-area.viewport-y / area.viewport-height) * parent.height;
            width: 100%;
            height: (area.height / area.viewport-height) * parent.height;
            background: black;
        }
    }
}

// Text that scrolls a character at a time when it doesn't fit. Only the highlighted list item
// uses it, so the other items stay a single text element (lists create all their items).
component ScrollingText {
    in property <string> text;
    // Room for the text, given by the list: using this element's own width would make the
    // width depend on the text (a binding loop).
    in property <length> text-width;

    // Measures the full width of the text (the shown copy is cut short)
    i-measure := Text {
        width: 0px;
        text: root.text;
        visible: false;
    }

    // How far the text overflows
    private property <length> excess: max(0px, i-measure.preferred-width - root.text-width);
    // Steps a character at a time and only draws what fits: drawing the whole name and clipping
    // it needs more renderer memory than there is.
    private property <int> chars: TextUtil.length(root.text);
    private property <int> last-step: root.excess > 0px
        ? ceil(root.excess / (i-measure.preferred-width / max(1, root.chars))) + 1
        : 0;
    // When scrolling started, so the text starts from its beginning
    private property <int> start: 0;
    // One character per tick (150 ms), pausing about 1 s (7 ticks) at each end.
    private property <int> step: root.last-step > 0
        ? clamp(mod(TextUtil.tick - root.start, root.last-step + 14) - 7, 0, root.last-step)
        : 0;

    init => {
        root.start = TextUtil.tick;
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.step == 0 ? root.text : TextUtil.tail(root.text, root.step);
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
    }
}

component TextListItem {
    in property <string> text;
    // Scroll the text if it doesn't fit (for the highlighted item)
    in property <bool> scroll: false;
    // Room for the text when scrolling
    in property <length> text-width;
    // Extra height
    in property <length> extra-height: 0px;
    height: i-text.min-height + 2px + root.extra-height;

    i-text := Text {
        x: 2px;
        width: root.width - 4px;
        text: root.text;
        visible: !root.scroll;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
    }

    if root.scroll: ScrollingText {
        x: 2px;
        width: root.width - 4px;
        height: root.height;
        text: root.text;
        text-width: root.text-width;
    }
}

export component TextListView inherits ListViewBase {
    in property <[string]> model;
    // Scroll the highlighted item's text if it's too long to show
    in property <bool> scroll-focused: false;
    // Extra height per item. Fewer items on screen means less text to draw per frame, and the
    // software renderer needs a contiguous block that grows with the amount of text.
    in property <length> item-padding: 0px;
    num-items: model.length;

    for item[index] in root.model: child-items := TextListItem {
        text: item;
        scroll: root.scroll-focused && index == root.focus-item;
        // List width less its border, padding and scroll bar
        text-width: root.width - 12px;
        extra-height: root.item-padding;
    }
}
