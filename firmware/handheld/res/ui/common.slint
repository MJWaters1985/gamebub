import "../fonts/ark-pixel-12px-proportional.ttf";
import "../fonts/ark-pixel-12px-proportional-bold.ttf";
import {
    SettingEntry,
    SettingValue,
    SettingType,
    SettingDatetime,
} from "screens/settings/types.slint";
import { FileListEntry } from "components/file_list.slint";
import { CoreSubscreen, CoreListEntry } from "screens/cores/types.slint";

export enum ScreenId {
    Setup,
    MainMenu,
    Game,
    Settings,
    Tools,
    Error,
    About,
    Cores,
    Library,
    Wifi,
}

export struct BatteryInfo {
    vbus_pgood: bool,
    is_charging: bool,
    voltage: float,
    level: float,
    current: float,
}

export global Palette { }

export global Global {
    // Window height
    in-out property <length> window-height;
    // Whether Home is currently pressed.
    in-out property <bool> home-pressed: false;
    // Whether the current pressing of Home was used for a shortcut key combo.
    in-out property <bool> home-consumed;
    out property <ScreenId> current-screen: MainMenu;
    // Whether the UI is transparent. Start true for the boot animation.
    in-out property <bool> ui-transparent: true;
    in-out property <bool> ui-status-bar: true;

    public function set-screen(screen: ScreenId) {
        current-screen = screen;
        ui-transparent = (screen == ScreenId.Game || screen == ScreenId.Setup);
        Backend.screen-enter(screen);
    }
}

export global Backend {
    in property <string> hardware-serial;
    in property <string> hardware-version;
    in property <string> firmware-version;

    in property <bool> docked: false;
    in property <string> dock-serial;
    in property <string> dock-firmware-version;

    in property <bool> sdcard-mounted: true;
    // Time shown in the status bar (empty when the clock is turned off)
    in property <string> clock-text;
    // Why the SD card isn't usable (empty if it is)
    in property <string> sdcard-status;

    in-out property <bool> volume-visible: false;
    in-out property <int> volume-level: 50;
    in property <int> volume-increment: 5;

    in-out property <bool> brightness-visible: false;
    in-out property <int> brightness-level: 50;
    in property <int> brightness-increment: 5;

    in property <int> battery-level: 11;

    in property <string> error-text: "";

    in property <bool> notification-visible: false;
    in property <string> notification-text: "I am a notification!";

    in property <[SettingEntry]> settings: [
        {
            name: "list",
            type: SettingType.list,
            choices: ["Low", "Medium", "High"],
            value: { int-value: 1 }
        },
        { name: "check 1", type: SettingType.checkbox, value: { bool-value: true } },
        { name: "check 2", type: SettingType.checkbox, value: { bool-value: false } },
        { name: "check 3", type: SettingType.checkbox, value: { bool-value: true } },
        { name: "subpage", type: SettingType.subpage },
        {
            name: "datetime",
            type: SettingType.datetime,
            value: { datetime-value: { year: 2024, month: 3, day: 31, hour: 9, min: 30 } }
        },
    ];
    in-out property <int> settings-index: 0;
    // Screen to return to when leaving the settings.
    in property <ScreenId> settings-return-screen: ScreenId.MainMenu;

    in-out property <CoreSubscreen> core-subscreen;
    in property <[CoreListEntry]> core-list;
    in-out property <int> core-list-index;
    in property <string> core-file-select-label: "";
    in property <[FileListEntry]> core-file-select-list: [];
    in property <string> core-file-select-path: "/fake/path/";
    in property <bool> core-file-select-is-loading: false;
    in-out property <string> core-file-select-error;
    in-out property <int> core-file-select-index: 0;
    // True while a core is waiting for the user to select a file.
    in property <bool> core-file-select-active: false;
    in-out property <int> core-selected-index: 0;
    in-out property <string> core-error;
    in property <percent> core-progress: 0%;
    in property <bool> core-is-loading: false;
    // Whether the running game was loaded from a file (rather than a cartridge).
    in property <bool> game-can-load-rom: false;

    callback volume-changed(int);
    callback brightness-changed(int);
    callback power-off();
    callback reboot();

    callback setup-complete();
    callback main-menu-run-cartridge();
    callback game-set-focused(bool);
    callback game-reset();
    callback game-exit();
    callback game-load-rom();
    callback settings-changed(int, SettingValue);
    callback settings-back() -> bool;
    callback tools-start-usb-drive();
    callback tools-end-usb-drive();
    callback tools-start-cart-reader();
    callback tools-end-cart-reader();
    callback tools-get-battery-info() -> BatteryInfo;

    // Run ROM. View: 0 systems, 1 games
    in-out property <int> library-view: 0;
    in property <[string]> library-systems;
    in property <bool> library-empty;
    in-out property <int> library-system-index: 0;
    in property <string> library-system-name;
    in property <[string]> library-games;
    in-out property <int> library-game-index: 0;
    // Box art, as strips stacked top to bottom (see library::load_thumbnail)
    in property <[image]> library-boxart;
    in property <int> library-boxart-width: 1;
    in property <int> library-boxart-height: 1;
    // Shown at reduced resolution because memory was low
    in property <bool> library-boxart-reduced;
    in property <bool> library-has-boxart;
    in property <string> library-boxart-note: "No box art";
    callback library-open();
    callback library-open-system(int);
    callback library-focus-game(int);
    callback library-run-game(int);
    callback library-close();
    callback library-clear-boxart();

    // Wi-Fi screen. View: 0 menu, 1 busy, 2 networks, 3 password, 4 result
    in-out property <int> wifi-view: 0;
    in property <string> wifi-status;
    in property <bool> wifi-has-network;
    in property <string> wifi-busy-label;
    in property <[string]> wifi-networks;
    in property <string> wifi-selected-ssid;
    in property <string> wifi-password;
    in property <string> wifi-result;
    in property <bool> wifi-result-ok;
    callback wifi-open();
    callback wifi-scan();
    callback wifi-select-network(int);
    callback wifi-typed(string);
    callback wifi-deleted();
    callback wifi-join();
    callback wifi-test();
    callback wifi-forget();

    // Tools task (box art download)
    in property <string> task-label;
    in property <float> task-progress: -1;
    in-out property <bool> task-done: false;
    in property <string> task-result;
    in property <bool> task-result-ok;
    callback boxart-download-all();
    // Tools > Set Up SD Card (true: erase and format first)
    callback sd-setup(bool);
    // Tools > Set Up SD Card > Check ROMs (reads only)
    callback sd-check();

    // Cartridge Manager. View: 0 busy, 1 menu, 2 save list, 3 result
    in-out property <int> cart-tool-view: 0;
    in property <string> cart-tool-title;
    in property <string> cart-tool-details;
    in property <[string]> cart-tool-actions;
    in property <[string]> cart-tool-saves;
    in-out property <string> cart-tool-busy-label;
    // 0-100, or negative when progress isn't known
    in-out property <float> cart-tool-progress: -1;
    in property <string> cart-tool-result;
    in property <bool> cart-tool-result-ok;
    callback cart-tool-start();
    callback cart-tool-action(int);
    callback cart-tool-restore(int);
    callback cart-tool-exit();
    callback core-list-fetch();
    callback core-run(string);
    callback core-file-select-selected(int);
    callback core-file-select-up();
    callback core-file-select-cancel();
    callback core-file-select-favorite(int);
    callback core-file-select-settings();

    callback screen-enter(ScreenId);

    callback datetime-add(SettingDatetime, SettingDatetime) -> SettingDatetime;
}
