import { TextListView } from "../../components/list_view.slint";
import { ControlHint } from "../../components/control_hint.slint";

export component CoreDetails {
    in property <string> core-name;
    in property <string> core-author;

    callback on-cancel();
    callback on-run();

    forward-focus: i-actions;

    i-focus-scope := FocusScope {

        key-pressed(event) => {
            if (event.text == "b") {
                on-cancel();
                accept
            } else {
                reject
            }
        }

        // Laid out like the other menus: details, a list of actions, button hints at the bottom.
        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    horizontal-alignment: right;
                    font-weight: 800;
                    text: ( //
                            "Name:" + //
                            "\nAuthor:" //
                        );
                }

                Text {
                    horizontal-alignment: left;
                    text: ( //
                            "\{core-name}" + //
                            "\n\{core-author}" //
                        );
                }
            }

            i-actions := TextListView {
                vertical-stretch: 1;
                model: ["Run Core", "Back"];
                on-item-selected(i) => {
                    if i == 0 {
                        on-run();
                    } else {
                        on-cancel();
                    }
                }
            }

            HorizontalLayout {
                alignment: space-between;

                ControlHint {
                    label: "Back";
                    button: "b";
                }

                ControlHint {
                    label: "Select";
                    button: "a";
                }
            }
        }
    }
}
