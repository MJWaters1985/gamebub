import { StatusMessage, StatusKind } from "../../components/status_message.slint";
import { ControlHint } from "../../components/control_hint.slint";

export component CoreError {
    in property <string> error;

    callback on-confirm();

    forward-focus: i-focus-scope;

    i-focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == "a") {
                on-confirm();
                accept
            } else {
                reject
            }
        }

        // Status icon and message centered above the button hints, which stay on the bottom edge.
        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;

            StatusMessage {
                vertical-stretch: 1;
                kind: StatusKind.error;
                title: "Core Error";
                text: error;
            }

            HorizontalLayout {
                alignment: end;
                ControlHint {
                    label: "Confirm";
                    button: "a";
                }
            }
        }
    }
}
