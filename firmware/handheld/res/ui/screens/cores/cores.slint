import { Global, ScreenId, Backend } from "../../common.slint";
import { ScreenBase } from "../../components/screen.slint";
import { CoreSubscreen } from "types.slint";
import { CoreFileSelect } from "core_file_select.slint";
import { CoreError } from "core_error.slint";

// File selection and load errors for a core being started (from Run ROM, Run Cartridge or the
// game menu's Load ROM).
export component CoresScreen inherits ScreenBase {
    title: Backend.core-file-select-active ? "Select " + Backend.core-file-select-label : "Error";

    // Where to go when file selection is cancelled or an error is dismissed: back to Run ROM if
    // the game was started from a file, otherwise the main menu.
    function leave() {
        Global.set-screen(Backend.game-can-load-rom && Backend.sdcard-mounted ? ScreenId.Library : ScreenId.MainMenu);
    }

    init => {
        if (!Backend.core-error.is-empty) {
            Backend.core-subscreen = CoreSubscreen.Error;
        } else {
            Backend.core-subscreen = CoreSubscreen.FileSelect;
        }
    }

    if Backend.core-subscreen == CoreSubscreen.FileSelect: CoreFileSelect {
        width: 100%;
        height: 100%;

        init => {
            self.focus();
        }
        on-cancel => {
            Backend.core-file-select-cancel();
            root.leave();
        }
    }

    if Backend.core-subscreen == CoreSubscreen.Error: CoreError {
        width: 100%;
        height: 100%;

        error: Backend.core-error;

        init => {
            self.focus();
        }
        on-confirm => {
            Backend.core-error = "";
            Backend.core-file-select-cancel();
            root.leave();
        }
    }
}
