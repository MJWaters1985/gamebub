import { Global, ScreenId, Backend, BatteryInfo } from "../../common.slint";
import { ScreenBase } from "../../components/screen.slint";
import { TextListView } from "../../components/list_view.slint";
import { ControlHint } from "../../components/control_hint.slint";

export component ToolsScreen inherits ScreenBase {
    in property <[string]> tools: [
        "Cartridge Manager",
        "Download Box Art",
        "Mount SD Card over USB",
        "Set Up SD Card",
        "FlashGBX Cartridge Backup / Restore",
        "Debug battery info"
    ];
    private property <int> selected-tool: -1;

    title: "Tools";
    forward-focus: i-focus-scope;

    i-focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == "b") {
                if selected-tool == -1 {
                    Global.set-screen(ScreenId.MainMenu);
                }
                accept
            } else {
                reject
            }
        }

        if selected-tool == -1: VerticalLayout {
            height: 100%;
            spacing: 2px;

            init => {
                list.focus();
            }

            list := TextListView {
                model: root.tools;
                wrap: true;
                on-item-selected(i) => {
                    debug("on-item-selected ", i);
                    root.selected-tool = i;
                }
            }

            HorizontalLayout {
                alignment: space-between;

                ControlHint {
                    label: "Back";
                    button: "b";
                }

                ControlHint {
                    label: "Select";
                    button: "a";
                }
            }
        }

        // Cartridge Manager: dump ROMs and back up / restore saves on the device
        if selected-tool == 0: FocusScope {
            // Index of the save picked for restoring (confirmation pending), or -1
            private property <int> confirm-save: -1;

            init => {
                self.focus();
                Backend.cart-tool-view = 0;
                Backend.cart-tool-busy-label = "Starting...";
                Backend.cart-tool-progress = -1;
                Backend.cart-tool-start();
            }

            function exit() {
                Backend.cart-tool-exit();
                root.selected-tool = -1;
            }

            key-released(event) => {
                if event.text == "Home" && !Global.home-consumed && Backend.cart-tool-view != 0 {
                    exit();
                    accept
                } else {
                    reject
                }
            }

            // Busy: label and progress bar
            if Backend.cart-tool-view == 0: VerticalLayout {
                alignment: center;
                spacing: 12px;
                padding: 24px;

                Text {
                    horizontal-alignment: center;
                    text: Backend.cart-tool-busy-label;
                }

                if Backend.cart-tool-progress >= 0: Rectangle {
                    height: 12px;
                    border-color: black;
                    border-width: 1px;

                    Rectangle {
                        x: 2px;
                        y: 2px;
                        height: parent.height - 4px;
                        width: (parent.width - 4px) * min(1, Backend.cart-tool-progress / 100);
                        background: black;
                    }
                }

                if Backend.cart-tool-progress >= 0: Text {
                    horizontal-alignment: center;
                    text: "\{Math.round(Backend.cart-tool-progress)}%";
                }

                Text {
                    horizontal-alignment: center;
                    text: "Don't remove the cartridge";
                    color: #666;
                }
            }

            // Menu: cartridge details and actions
            if Backend.cart-tool-view == 1 && confirm-save < 0: FocusScope {
                init => {
                    actions.focus();
                }
                key-pressed(event) => {
                    if event.text == "b" {
                        exit();
                        accept
                    } else {
                        reject
                    }
                }

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    Text {
                        font-weight: 800;
                        wrap: word-wrap;
                        text: Backend.cart-tool-title;
                    }

                    Text {
                        wrap: word-wrap;
                        text: Backend.cart-tool-details;
                    }

                    actions := TextListView {
                        min-height: 80px;
                        model: Backend.cart-tool-actions;
                        on-item-selected(i) => {
                            Backend.cart-tool-action(i);
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        ControlHint {
                            label: "Exit";
                            button: "b";
                        }

                        ControlHint {
                            label: "Select";
                            button: "a";
                        }
                    }
                }
            }

            // Save list for restoring
            if Backend.cart-tool-view == 2 && confirm-save < 0: FocusScope {
                init => {
                    saves.focus();
                }
                key-pressed(event) => {
                    if event.text == "b" {
                        Backend.cart-tool-view = 1;
                        accept
                    } else {
                        reject
                    }
                }

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    Text {
                        font-weight: 800;
                        text: "Restore which save?";
                    }

                    saves := TextListView {
                        model: Backend.cart-tool-saves;
                        on-item-selected(i) => {
                            confirm-save = i;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        ControlHint {
                            label: "Back";
                            button: "b";
                        }

                        ControlHint {
                            label: "Restore";
                            button: "a";
                        }
                    }
                }
            }

            // Confirm before writing to the cartridge
            if confirm-save >= 0: FocusScope {
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    if event.text == "a" {
                        Backend.cart-tool-restore(confirm-save);
                        confirm-save = -1;
                        accept
                    } else if event.text == "b" {
                        confirm-save = -1;
                        accept
                    } else {
                        reject
                    }
                }

                VerticalLayout {
                    alignment: center;
                    padding: 16px;
                    spacing: 12px;

                    Text {
                        horizontal-alignment: center;
                        font-weight: 800;
                        text: "Overwrite the save on the cartridge?";
                    }

                    Text {
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        text: "\{Backend.cart-tool-saves[confirm-save]}\n\nThe cartridge's current save is backed up first.";
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        ControlHint {
                            label: "Cancel";
                            button: "b";
                        }

                        ControlHint {
                            label: "Restore";
                            button: "a";
                        }
                    }
                }
            }

            // Result of an operation
            if Backend.cart-tool-view == 3: FocusScope {
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    if event.text == "a" || event.text == "b" {
                        // Back to the menu (reads the cartridge again if needed)
                        Backend.cart-tool-action(999);
                        accept
                    } else {
                        reject
                    }
                }

                VerticalLayout {
                    alignment: center;
                    padding: 16px;
                    spacing: 12px;

                    Text {
                        horizontal-alignment: center;
                        font-weight: 800;
                        text: Backend.cart-tool-result-ok ? "Done" : "Problem";
                    }

                    Text {
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        text: Backend.cart-tool-result;
                    }

                    HorizontalLayout {
                        alignment: end;

                        ControlHint {
                            label: "OK";
                            button: "a";
                        }
                    }
                }
            }
        }

        // Download box art for games in /roms that don't have it
        if selected-tool == 1: FocusScope {
            init => {
                self.focus();
                Backend.task-done = false;
                Backend.boxart-download-all();
            }
            key-released(event) => {
                if event.text == "b" && Backend.task-done {
                    root.selected-tool = -1;
                    accept
                } else {
                    reject
                }
            }

            if !Backend.task-done: VerticalLayout {
                alignment: center;
                spacing: 12px;
                padding: 24px;

                Text {
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    text: Backend.task-label;
                }

                if Backend.task-progress >= 0: Rectangle {
                    height: 12px;
                    border-color: black;
                    border-width: 1px;

                    Rectangle {
                        x: 2px;
                        y: 2px;
                        height: parent.height - 4px;
                        width: (parent.width - 4px) * min(1, Backend.task-progress / 100);
                        background: black;
                    }
                }
            }

            if Backend.task-done: VerticalLayout {
                alignment: center;
                spacing: 12px;
                padding: 16px;

                Text {
                    horizontal-alignment: center;
                    font-weight: 800;
                    text: Backend.task-result-ok ? "Done" : "Problem";
                }

                Text {
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    text: Backend.task-result;
                }

                HorizontalLayout {
                    alignment: start;

                    ControlHint {
                        label: "Back";
                        button: "b";
                    }
                }
            }
        }

        // Set up the SD card: create folders, or erase and format it first
        if selected-tool == 3: FocusScope {
            // 0: menu, 1: confirm erasing, 2: working / result
            private property <int> view: 0;
            // How long A has been held on the confirmation screen
            private property <duration> held: 0ms;
            private property <bool> holding: false;

            init => {
                self.focus();
            }

            Timer {
                interval: 50ms;
                running: view == 1 && holding;
                triggered => {
                    held += 50ms;
                    if held >= 3s {
                        holding = false;
                        held = 0ms;
                        view = 2;
                        Backend.task-done = false;
                        Backend.sd-setup(true);
                    }
                }
            }

            if view == 0: FocusScope {
                init => {
                    choices.focus();
                }
                key-pressed(event) => {
                    if event.text == "b" {
                        root.selected-tool = -1;
                        accept
                    } else {
                        reject
                    }
                }

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    if Backend.sdcard-status != "": Text {
                        wrap: word-wrap;
                        font-weight: 800;
                        text: Backend.sdcard-status;
                    }

                    Text {
                        wrap: word-wrap;
                        text: "Game Bub needs a FAT32 card (exFAT cards can't be read). It keeps ROMs in /roms/<system>, saves in /saves, box art in /boxart and BIOS files in /system.";
                    }

                    choices := TextListView {
                        model: ["Create missing folders (keeps files)", "Check ROMs (reads only)", "Erase and format card"];
                        on-item-selected(i) => {
                            if i == 0 {
                                view = 2;
                                Backend.task-done = false;
                                Backend.sd-setup(false);
                            } else if i == 1 {
                                view = 2;
                                Backend.task-done = false;
                                Backend.sd-check();
                            } else {
                                held = 0ms;
                                view = 1;
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        ControlHint {
                            label: "Back";
                            button: "b";
                        }

                        ControlHint {
                            label: "Select";
                            button: "a";
                        }
                    }
                }
            }

            if view == 1: FocusScope {
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    if event.text == "a" {
                        holding = true;
                        accept
                    } else if event.text == "b" && !event.repeat {
                        holding = false;
                        held = 0ms;
                        view = 0;
                        accept
                    } else {
                        reject
                    }
                }
                key-released(event) => {
                    if event.text == "a" {
                        holding = false;
                        held = 0ms;
                        accept
                    } else {
                        reject
                    }
                }

                VerticalLayout {
                    alignment: center;
                    padding: 16px;
                    spacing: 12px;

                    Text {
                        horizontal-alignment: center;
                        font-weight: 800;
                        text: "Erase the SD card?";
                    }

                    Text {
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        text: "Everything on the card is deleted: ROMs, saves, save backups, box art and screenshots. BIOS files in /system are kept.\n\nHold A for 3 seconds to erase.";
                    }

                    Rectangle {
                        height: 12px;
                        border-color: black;
                        border-width: 1px;

                        Rectangle {
                            x: 2px;
                            y: 2px;
                            height: parent.height - 4px;
                            width: (parent.width - 4px) * min(1, held / 3s);
                            background: black;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        ControlHint {
                            label: "Cancel";
                            button: "b";
                        }

                        ControlHint {
                            label: "Hold to erase";
                            button: "a";
                        }
                    }
                }
            }

            if view == 2: FocusScope {
                init => {
                    self.focus();
                }
                key-released(event) => {
                    if event.text == "b" && Backend.task-done {
                        root.selected-tool = -1;
                        accept
                    } else {
                        reject
                    }
                }

                if !Backend.task-done: Text {
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    text: Backend.task-label + "\n\nDon't remove the SD card.";
                }

                if Backend.task-done: VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    padding: 16px;

                    Text {
                        horizontal-alignment: center;
                        font-weight: 800;
                        text: Backend.task-result-ok ? "Done" : "Problem";
                    }

                    Text {
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        text: Backend.task-result;
                    }

                    HorizontalLayout {
                        alignment: start;

                        ControlHint {
                            label: "Back";
                            button: "b";
                        }
                    }
                }
            }
        }

        // Mount SD card over USB
        if selected-tool == 2: FocusScope {
            init => {
                self.focus();
                if Backend.sdcard-mounted {
                    Backend.tools-start-usb-drive();
                }
            }
            key-released(event) => {
                if event.text == "Home" && !Global.home-consumed {
                    Backend.tools-end-usb-drive();
                    accept
                } else {
                    reject
                }
            }

            if Backend.sdcard-mounted: Text {
                horizontal-alignment: center;
                text: "Now exposing the SD card as USB drive";
            }

            if !Backend.sdcard-mounted: Text {
                horizontal-alignment: center;
                text: "Error: no SD card mounted";
            }

            ControlHint {
                label: "Exit";
                button: "home";
                y: root.height - self.height - 8px;
            }
        }

        // Cartridge backup / restore
        if selected-tool == 4: FocusScope {
            init => {
                self.focus();
                Backend.tools-start-cart-reader();
            }
            key-released(event) => {
                if event.text == "Home" && !Global.home-consumed {
                    Backend.tools-end-cart-reader();
                    accept
                } else {
                    reject
                }
            }
            Text {
                horizontal-alignment: center;
                text: "Cartridge Backup and Restore Mode\n\nConnect Game Bub to a computer running FlashGBX\nSee the User Guide for more information";
            }

            ControlHint {
                label: "Exit";
                button: "home";
                y: root.height - self.height - 8px;
            }
        }

        // Debug battery info
        if selected-tool == 5: FocusScope {
            private property <BatteryInfo> info;
            init => {
                self.focus();
            }
            key-released(event) => {
                if event.text == "b" {
                    root.selected-tool = -1;
                    accept
                } else {
                    reject
                }
            }

            Text {
                y: 8px;
                horizontal-alignment: center;
                font-weight: 800;
                text: "Battery Info";
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                width: 100%;
                y: (root.height - self.min-height) / 2;

                Text {
                    width: 45%;
                    horizontal-alignment: right;
                    text: ( //
                            "Charging:" + //
                            "\nVBUS Good:" + //
                            "\nVoltage:" + //
                            "\nLevel:" + //
                            "\nCurrent:" //
                        );
                }

                Text {
                    width: 45%;
                    horizontal-alignment: left;
                    text: ( //
                            "\{info.is-charging ? "yes" : "no"}" + //
                            "\n\{info.vbus-pgood ? "yes" : "no"}" + //
                            "\n\{info.voltage.to-fixed(2)} V" + //
                            "\n\{info.level.to_fixed(2)}%" + //
                            "\n\{info.current.to-fixed(3)} A" //
                        );
                }
            }

            ControlHint {
                label: "Back";
                button: "b";
                y: root.height - self.height - 8px;
            }

            Timer {
                interval: 500ms;
                triggered => {
                    info = Backend.tools-get-battery-info();
                }
            }
        }
    }
}
