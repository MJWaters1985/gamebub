import { StatusMessage, ProgressBar } from "../components/status_message.slint";
import { Global, ScreenId, Backend } from "../common.slint";
import { ScreenBase } from "../components/screen.slint";
import { Button } from "../components/button.slint";
import { ButtonList } from "../components/button_list.slint";

export component GameScreen inherits ScreenBase {
    private property <bool> menu-open: false;
    forward-focus: i-focus-scope;

    protected function set-menu-open(open: bool) {
        Global.ui-status-bar = open;
        Backend.game-set-focused(!open);
        self.menu-open = open;
        if (menu-open) {
            i-list.focus();
        } else {
            i-focus-scope.focus();
        }
    }

    i-focus-scope := FocusScope {
        key-released(event) => {
            if (event.text == "Home" || event.text == "h") && !Global.home-consumed {
                set-menu-open(!root.menu-open);
            }
            if (event.text == "Power") {
                set-menu-open(true);
            }
            reject
        }

        menu := Rectangle {
            visible: menu-open;
            background: #FFF;
            border-color: black;
            border-width: 1px;
            width: i-list.min-width + 20px;
            height: i-list.min-height;

            i-list := ButtonList {
                items: Backend.game-can-load-rom
                    ? ["Return", "Load ROM", "Reset", "Exit Core"]
                    : ["Return", "Reset", "Exit Core"];
                on-selected(item) => {
                    if (self.items[item] == "Return") {
                        root.set-menu-open(false);
                    } else if (self.items[item] == "Load ROM") {
                        Backend.game-load-rom();
                    } else if (self.items[item] == "Reset") {
                        Backend.game-reset();
                        root.set-menu-open(false);
                    } else if (self.items[item] == "Exit Core") {
                        Backend.game-exit();
                    }
                }
            }
        }

        // Loading: a busy message over the whole screen, like the other busy screens.
        if Backend.core-is-loading: Rectangle {
            background: #E8E8E8;

            StatusMessage {
                padding-left: 8px;
                padding-right: 8px;
                title: "Loading...";

                HorizontalLayout {
                    padding-left: 40px;
                    padding-right: 40px;

                    ProgressBar {
                        progress: Backend.core-progress;
                    }
                }
            }
        }
    }
}
