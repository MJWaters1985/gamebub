import { Global, ScreenId, Backend } from "../common.slint";
import { ScreenBase } from "../components/screen.slint";
import { TextListView } from "../components/list_view.slint";
import { ControlHint } from "../components/control_hint.slint";
import { StatusMessage, StatusKind } from "../components/status_message.slint";

// "Run ROM": pick a system, then a game from /roms/<system>.
export component LibraryScreen inherits ScreenBase {
    title: Backend.library-view == 0 ? "Run ROM" : Backend.library-system-name;
    forward-focus: i-focus-scope;

    init => {
        Backend.library-open();
    }

    i-focus-scope := FocusScope {
        // Systems
        if Backend.library-view == 0: FocusScope {
            init => {
                if Backend.library-empty {
                    self.focus();
                } else {
                    systems.focus();
                }
            }
            key-pressed(event) => {
                if event.text == "b" {
                    Backend.library-close();
                    Global.set-screen(ScreenId.MainMenu);
                    accept
                } else {
                    reject
                }
            }

            VerticalLayout {
                spacing: 2px;

                if Backend.library-empty: StatusMessage {
                    vertical-stretch: 1;
                    kind: StatusKind.empty;
                    title: "No ROMs yet";
                    text: "Dump cartridges with Tools → Cartridge Manager, or copy ROMs to /roms/Game Boy, /roms/Game Boy Color or /roms/Game Boy Advance on the SD card.";
                }

                systems := TextListView {
                    visible: !Backend.library-empty;
                    // Hidden lists still take part in the layout: give the message the room.
                    max-height: Backend.library-empty ? 0px : 10000px;
                    model: Backend.library-systems;
                    focus-item <=> Backend.library-system-index;
                    on-item-selected(i) => {
                        Backend.library-open-system(i);
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    ControlHint {
                        label: "Back";
                        button: "b";
                    }

                    if !Backend.library-empty: ControlHint {
                        label: "Open";
                        button: "a";
                    }
                }
            }
        }

        // Games, with the highlighted game's box art
        if Backend.library-view == 1: FocusScope {
            init => {
                games.focus();
                games.ensure-focus-visible();
            }
            key-pressed(event) => {
                if event.text == "b" {
                    Backend.library-open();
                    accept
                } else {
                    reject
                }
            }

            // Load box art shortly after the highlight stops moving.
            boxart-timer := Timer {
                interval: 150ms;
                running: false;
                triggered => {
                    self.running = false;
                    Backend.library-focus-game(Backend.library-game-index);
                }
            }

            VerticalLayout {
                spacing: 2px;

                HorizontalLayout {
                    spacing: 4px;

                    games := TextListView {
                        horizontal-stretch: 1;
                        scroll-focused: true;
                        page-keys: true;
                        item-padding: 10px;
                        model: Backend.library-games;
                        focus-item <=> Backend.library-game-index;
                        on-item-focused(i) => {
                            // Free the old box art now; load the new one once the screen has
                            // redrawn (only then is the old image's memory released).
                            Backend.library-clear-boxart();
                            boxart-timer.running = false;
                            boxart-timer.running = true;
                        }
                        on-item-selected(i) => {
                            Backend.library-run-game(i);
                        }
                    }

                    Rectangle {
                        // Fixed width, and a scale that doesn't depend on the panel's size: the
                        // box art's size feeds into the layout, so deriving the scale from the
                        // panel's laid-out size can feed back on itself.
                        width: 128px;
                        horizontal-stretch: 0;
                        border-color: black;
                        border-width: 1px;

                        // Whole-number scale that fits the panel's width: the renderer doesn't
                        // smooth when scaling, so fractional scales double some pixels and not
                        // others. Box art is at most 120 pixels tall, which fits at this scale.
                        property <float> boxart-scale: max(1, floor((128 - 8) / Backend.library-boxart-width));

                        // Not inside an `if`: a hidden `if` stops updating its contents, so the
                        // previous image would stay referenced (and its buffers copied on the
                        // next load) until it's shown again. An empty model shows nothing; the
                        // stretchy spacers keep the column from collapsing when it's empty, and
                        // center the image when it isn't.
                        VerticalLayout {
                            spacing: 0px;

                            Rectangle { }

                            // Strips are the full box art width; show only this image's part.
                            for strip[i] in Backend.library-boxart: HorizontalLayout {
                                alignment: center;
                                property <int> rows: min(strip.height, Backend.library-boxart-height - i * strip.height);

                                Image {
                                    source: strip;
                                    source-clip-width: Backend.library-boxart-width;
                                    source-clip-height: rows;
                                    width: Backend.library-boxart-width * boxart-scale * 1px;
                                    height: rows * boxart-scale * 1px;
                                    image-fit: fill;
                                    image-rendering: pixelated;
                                }
                            }

                            Rectangle { }
                        }

                        if Backend.library-has-boxart && Backend.library-boxart-reduced: Text {
                            y: parent.height - self.height - 2px;
                            width: parent.width;
                            horizontal-alignment: center;
                            font-size: 10px;
                            color: #888;
                            text: "Reduced (low memory)";
                        }

                        if !Backend.library-has-boxart: Text {
                            width: parent.width - 8px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            color: #666;
                            text: Backend.library-boxart-note;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    ControlHint {
                        label: "Back";
                        button: "b";
                    }

                    ControlHint {
                        label: "Play";
                        button: "a";
                    }
                }
            }
        }
    }
}
