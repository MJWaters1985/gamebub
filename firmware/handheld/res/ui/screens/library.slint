import { Global, ScreenId, Backend } from "../common.slint";
import { ScreenBase } from "../components/screen.slint";
import { TextListView } from "../components/list_view.slint";
import { ControlHint } from "../components/control_hint.slint";

// "Run ROM": pick a system, then a game from /roms/<system>.
export component LibraryScreen inherits ScreenBase {
    title: Backend.library-view == 0 ? "Run ROM" : Backend.library-system-name;
    forward-focus: i-focus-scope;

    init => {
        Backend.library-open();
    }

    i-focus-scope := FocusScope {
        // Systems
        if Backend.library-view == 0: FocusScope {
            init => {
                if Backend.library-empty {
                    self.focus();
                } else {
                    systems.focus();
                }
            }
            key-pressed(event) => {
                if event.text == "b" {
                    Backend.library-close();
                    Global.set-screen(ScreenId.MainMenu);
                    accept
                } else {
                    reject
                }
            }

            VerticalLayout {
                spacing: 2px;

                if Backend.library-empty: Text {
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    text: "No ROMs yet.\n\nDump cartridges with Tools → Cartridge Manager,\nor copy ROMs to /roms/Game Boy, /roms/Game Boy Color\nor /roms/Game Boy Advance on the SD card.";
                }

                systems := TextListView {
                    visible: !Backend.library-empty;
                    model: Backend.library-systems;
                    focus-item <=> Backend.library-system-index;
                    on-item-selected(i) => {
                        Backend.library-open-system(i);
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    ControlHint {
                        label: "Back";
                        button: "b";
                    }

                    if !Backend.library-empty: ControlHint {
                        label: "Open";
                        button: "a";
                    }
                }
            }
        }

        // Games, with the highlighted game's box art
        if Backend.library-view == 1: FocusScope {
            init => {
                games.focus();
                games.ensure-focus-visible();
            }
            key-pressed(event) => {
                if event.text == "b" {
                    Backend.library-open();
                    accept
                } else {
                    reject
                }
            }

            // Load box art shortly after the highlight stops moving.
            boxart-timer := Timer {
                interval: 150ms;
                running: false;
                triggered => {
                    self.running = false;
                    Backend.library-focus-game(Backend.library-game-index);
                }
            }

            VerticalLayout {
                spacing: 2px;

                HorizontalLayout {
                    spacing: 4px;

                    games := TextListView {
                        horizontal-stretch: 3;
                        scroll-focused: true;
                        model: Backend.library-games;
                        focus-item <=> Backend.library-game-index;
                        on-item-focused(i) => {
                            // Free the old box art now; load the new one once the screen has
                            // redrawn (only then is the old image's memory released).
                            Backend.library-clear-boxart();
                            boxart-timer.running = false;
                            boxart-timer.running = true;
                        }
                        on-item-selected(i) => {
                            Backend.library-run-game(i);
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 2;
                        border-color: black;
                        border-width: 1px;

                        // Whole-number scale that fits the panel: the renderer doesn't smooth
                        // when scaling, so fractional scales double some pixels and not others.
                        property <float> boxart-scale: max(1, floor(min(
                            (self.width - 8px) / 1px / Backend.library-boxart-width,
                            (self.height - 8px) / 1px / Backend.library-boxart-height)));

                        if Backend.library-has-boxart: VerticalLayout {
                            alignment: center;
                            spacing: 0px;

                            for strip in Backend.library-boxart: HorizontalLayout {
                                alignment: center;

                                Image {
                                    source: strip;
                                    width: strip.width * boxart-scale * 1px;
                                    height: strip.height * boxart-scale * 1px;
                                    image-fit: fill;
                                    image-rendering: pixelated;
                                }
                            }
                        }

                        if Backend.library-has-boxart && Backend.library-boxart-reduced: Text {
                            y: parent.height - self.height - 2px;
                            width: parent.width;
                            horizontal-alignment: center;
                            font-size: 10px;
                            color: #888;
                            text: "Reduced (low memory)";
                        }

                        if !Backend.library-has-boxart: Text {
                            width: parent.width - 8px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            color: #666;
                            text: Backend.library-boxart-note;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    ControlHint {
                        label: "Back";
                        button: "b";
                    }

                    ControlHint {
                        label: "Play";
                        button: "a";
                    }
                }
            }
        }
    }
}
